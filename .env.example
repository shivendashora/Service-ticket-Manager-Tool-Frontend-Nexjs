# ---------------------------------------------------------
# BACKEND: keep exactly ONE BACKEND_URL uncommented
#
# The browser always calls /api/... on this app, and next.config.ts forwards
# those requests to BACKEND_URL. The auth cookie therefore stays on this app's
# domain, so login works the same locally and when deployed.
# On Vercel, set BACKEND_URL under Project Settings -> Environment Variables
# and redeploy (rewrites are fixed at build time).
# ---------------------------------------------------------

# Local FastAPI (uvicorn main:app --port 8000)
BACKEND_URL=http://localhost:8000

# Local Flask (python app.py)
# BACKEND_URL=http://localhost:5000

# Deployed FastAPI backend
# BACKEND_URL=https://your-fastapi-backend.onrender.com

# Deployed Flask backend (Supabase)
# BACKEND_URL=https://your-flask-backend.onrender.com

# ---------------------------------------------------------
# Optional: call the backend directly instead of through /api.
# Only needed if you don't want the proxy; the backend then needs CORS
# and cross-site cookies (COOKIE_SECURE=true, COOKIE_SAMESITE=None).
# ---------------------------------------------------------
# NEXT_PUBLIC_API_URL=https://your-flask-backend.onrender.com
